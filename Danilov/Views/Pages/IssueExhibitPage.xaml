<Page x:Class="MuseumAccountingSystem.Views.Pages.IssueExhibitPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Выдача экспоната"
      Background="#1E1E1E">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Выдача экспоната" FontSize="24" FontWeight="Bold" Foreground="#F47B20" Margin="0,0,0,20"/>

            <Border Grid.Row="1" Background="#2D2D2D" Padding="20" Margin="0,0,0,20" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Выберите экспонат" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>

                    <ComboBox x:Name="cmbExhibit" Height="40" Background="#3D3D3D" BorderBrush="#555555" BorderThickness="1" Padding="5"/>

                    <Border Background="#252525" Padding="12" Margin="0,12,0,0" BorderBrush="#555555" BorderThickness="1" CornerRadius="5">
                        <TextBlock x:Name="txtExhibitInfo" Text="Выберите экспонат из списка" FontSize="12" TextWrapping="Wrap" Foreground="#9E9E9E"/>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Background="#2D2D2D" Padding="20" Margin="0,0,0,20" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Выберите преподавателя" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>
                    <ComboBox x:Name="cmbTeacher" Height="40" Background="#3D3D3D" Foreground="White" BorderBrush="#555555" BorderThickness="1" Padding="5"/>

                    <Button x:Name="btnAddTeacher" Content="+ Добавить преподавателя" Background="#6C3483" Foreground="White" FontSize="12" FontWeight="SemiBold" Width="180" Height="32" HorizontalAlignment="Left" Margin="0,12,0,0" Cursor="Hand" BorderThickness="0" Click="BtnAddTeacher_Click"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Background="#2D2D2D" Padding="20" Margin="0,0,0,20" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Планируемая дата возврата" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>
                    <DatePicker x:Name="dpPlannedReturn" Height="40" Background="#3D3D3D" Foreground="White" BorderBrush="#555555" BorderThickness="1"/>
                    <TextBlock x:Name="txtDateWarning" Foreground="#F47B20" FontSize="11" Margin="0,8,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="4" Background="#2D2D2D" Padding="20" Margin="0,0,0,20" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Цель выдачи" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>
                    <TextBox x:Name="txtPurposeDetail" Height="60" TextWrapping="Wrap" Background="#3D3D3D" Foreground="White" BorderBrush="#555555" BorderThickness="1" Padding="10" Text="Подробное описание цели"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="5" Background="#2D2D2D" Padding="20" CornerRadius="5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="btnIssue" Content="ВЫДАТЬ" Background="#27AE60" Foreground="White" FontSize="14" FontWeight="Bold" Width="160" Height="40" Cursor="Hand" BorderThickness="0" Click="BtnIssue_Click"/>
                    <Button x:Name="btnCancel" Content="Отмена" Background="#E74C3C" Foreground="White" FontSize="14" FontWeight="Bold" Width="160" Height="40" Margin="20,0,0,0" Cursor="Hand" BorderThickness="0" Click="BtnCancel_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
