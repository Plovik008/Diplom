<Page x:Class="MuseumAccountingSystem.Views.Pages.IssuesJournalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Журнал выдачи"
      Background="#ECF0F1">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Журнал выдачи экспонатов" FontSize="22" FontWeight="Bold" Foreground="#1A5276" Margin="0,0,0,20"/>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtSearch" Height="35" TextChanged="TxtSearch_TextChanged"/>

                <ComboBox x:Name="cmbStatusFilter" Grid.Column="1" Width="150" Height="35" Margin="10,0,0,0" SelectionChanged="CmbStatusFilter_SelectionChanged">
                    <ComboBoxItem Content="Все записи"/>
                    <ComboBoxItem Content="Выданы"/>
                    <ComboBoxItem Content="Возвращены"/>
                </ComboBox>

                <Button x:Name="btnRefresh" Grid.Column="2" Content="Обновить" Background="#2980B9" Foreground="White" Width="80" Height="35" Margin="10,0,0,0" Click="BtnRefresh_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="15">
            <DataGrid x:Name="dgvJournal" 
                      AutoGenerateColumns="False"
                      IsReadOnly="True">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Инв. номер" Binding="{Binding ExhibitInventoryNumber}" Width="100"/>
                    <DataGridTextColumn Header="Экспонат" Binding="{Binding ExhibitName}" Width="200"/>
                    <DataGridTextColumn Header="Преподаватель" Binding="{Binding TeacherName}" Width="180"/>
                    <DataGridTextColumn Header="Дата выдачи" Binding="{Binding IssueDate, StringFormat='dd.MM.yyyy'}" Width="100"/>
                    <DataGridTextColumn Header="Срок возврата" Binding="{Binding PlannedReturnDate, StringFormat='dd.MM.yyyy'}" Width="100"/>
                    <DataGridTextColumn Header="Дата возврата" Binding="{Binding ActualReturnDate, StringFormat='dd.MM.yyyy'}" Width="100"/>
                    <DataGridTextColumn Header="Цель" Binding="{Binding Purpose}" Width="150"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>