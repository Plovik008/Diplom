<Page x:Class="MuseumAccountingSystem.Views.Pages.IssuesJournalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Журнал выдачи"
      Background="#1E1E1E">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Журнал выдачи экспонатов" FontSize="24" FontWeight="Bold" Foreground="#F47B20" Margin="0,0,0,20"/>

        <Border Grid.Row="1" Background="#2D2D2D" Padding="20" Margin="0,0,0,20" CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtSearch" Height="35" Background="#3D3D3D" Foreground="White" BorderBrush="#555555" BorderThickness="1" Padding="10,0" TextChanged="TxtSearch_TextChanged"/>

                    <ComboBox x:Name="cmbStatusFilter" Grid.Column="1" Width="150" Height="35" Margin="10,0,0,0" Background="#3D3D3D" Foreground="White" BorderBrush="#555555" BorderThickness="1" SelectionChanged="CmbStatusFilter_SelectionChanged">
                    <ComboBoxItem Content="Все записи"/>
                    <ComboBoxItem Content="Выданы"/>
                    <ComboBoxItem Content="Возвращены"/>
                    <ComboBoxItem Content="Просрочены"/>
                </ComboBox>

                <Button x:Name="btnRefresh" Grid.Column="2" Content="Обновить" Background="#3D3D3D" Foreground="White" FontSize="13" FontWeight="SemiBold" Width="80" Height="35" Margin="10,0,0,0" Cursor="Hand" BorderThickness="1" BorderBrush="#555555" Click="BtnRefresh_Click"/>

                <Button x:Name="btnExport" Grid.Column="3" Content="📎 Экспорт в Excel" Background="#6C3483" Foreground="White" FontSize="13" FontWeight="SemiBold" Width="140" Height="35" Margin="10,0,0,0" Cursor="Hand" BorderThickness="0" Click="BtnExport_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#2D2D2D" Padding="20" CornerRadius="5">
            <DataGrid x:Name="dgvJournal" 
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      RowHeight="35"
                      Background="#3D3D3D"
                      Foreground="White"
                      RowBackground="#3D3D3D"
                      AlternatingRowBackground="#4D4D4D"
                      BorderBrush="#555555"
                      BorderThickness="1"
                      CanUserSortColumns="True">

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Выдан">
                                <Setter Property="Background" Value="#5D2E2E"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Возвращен">
                                <Setter Property="Background" Value="#2E5D2E"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Инв. номер" Binding="{Binding ExhibitInventoryNumber}" Width="100"/>
                    <DataGridTextColumn Header="Экспонат" Binding="{Binding ExhibitName}" Width="180"/>
                    <DataGridTextColumn Header="Преподаватель" Binding="{Binding TeacherName}" Width="150"/>
                    <DataGridTextColumn Header="Дата выдачи" Binding="{Binding IssueDate, StringFormat='dd.MM.yyyy'}" Width="100"/>
                    <DataGridTextColumn Header="План. возврат" Binding="{Binding PlannedReturnDate, StringFormat='dd.MM.yyyy'}" Width="100"/>
                    <DataGridTextColumn Header="Факт. возврат" Binding="{Binding ActualReturnDate, StringFormat='dd.MM.yyyy'}" Width="100"/>
                    <DataGridTextColumn Header="Цель" Binding="{Binding Purpose}" Width="150"/>
                    <DataGridTemplateColumn Header="Статус" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Выдан">
                                                    <Setter Property="Foreground" Value="#FF6B6B"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Возвращен">
                                                    <Setter Property="Foreground" Value="#4CD964"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
