<Page x:Class="MuseumAccountingSystem.Views.Pages.UsersListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Пользователи"
      Background="#1E1E1E">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Пользователи-преподаватели" FontSize="24" FontWeight="Bold" Foreground="#F47B20" Margin="0,0,0,20"/>

        <Border Grid.Row="1" Background="#3D3D3D" Padding="20" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtSearch" Height="35" Background="#2D2D2D" Foreground="White" BorderBrush="#555555" BorderThickness="1" Padding="10,0" TextChanged="TxtSearch_TextChanged"/>
                <Button Grid.Column="1" Content="Обновить" Background="#F47B20" Foreground="White" FontSize="13" FontWeight="SemiBold" Width="90" Height="35" Margin="10,0,0,0" Cursor="Hand" BorderThickness="0" Click="BtnRefresh_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#3D3D3D" Padding="20" Margin="0,0,0,20">
            <DataGrid x:Name="dgvUsers"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      Background="#2D2D2D"
                      Foreground="White"
                      RowBackground="#2D2D2D"
                      AlternatingRowBackground="#3D3D3D"
                      BorderBrush="#555555"
                      BorderThickness="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="300"/>
                    <DataGridTextColumn Header="Логин" Binding="{Binding Username}" Width="180"/>
                    <DataGridTextColumn Header="Пароль" Binding="{Binding Password}" Width="180"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" Background="#3D3D3D" Padding="20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnAdd" Content="Создать" Background="#27AE60" Foreground="White" FontSize="13" FontWeight="SemiBold" Width="120" Height="35" Cursor="Hand" BorderThickness="0" Click="BtnAdd_Click"/>
                <Button x:Name="btnEdit" Content="Редактировать" Background="#F47B20" Foreground="White" FontSize="13" FontWeight="SemiBold" Width="120" Height="35" Margin="10,0,0,0" Cursor="Hand" BorderThickness="0" Click="BtnEdit_Click"/>
                <Button x:Name="btnDelete" Content="Удалить" Background="#E74C3C" Foreground="White" FontSize="13" FontWeight="SemiBold" Width="120" Height="35" Margin="10,0,0,0" Cursor="Hand" BorderThickness="0" Click="BtnDelete_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
