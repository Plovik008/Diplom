<Page x:Class="MuseumAccountingSystem.Views.Pages.ExhibitsListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Экспонаты"
      Background="#1E1E1E">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtPageTitle" Text="Управление экспонатами" FontSize="24" FontWeight="Bold" Foreground="#F47B20" Margin="0,0,0,20"/>

        <Border Grid.Row="1" Background="#2D2D2D" Padding="15" Margin="0,0,0,20" CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtSearch" Grid.Column="0" Height="35" Background="#3D3D3D" Foreground="White" BorderBrush="#555555" BorderThickness="1" Padding="10,0"/>

                <Button x:Name="btnSearch" Grid.Column="1" Content="Найти" Background="#3D3D3D" Foreground="White" FontSize="13" FontWeight="SemiBold" Width="80" Height="35" Margin="10,0,0,0" Cursor="Hand" BorderThickness="1" BorderBrush="#555555" Click="BtnSearch_Click"/>

                <Button x:Name="btnRefresh" Grid.Column="2" Content="Обновить" Background="#3D3D3D" Foreground="White" FontSize="13" FontWeight="SemiBold" Width="80" Height="35" Margin="10,0,0,0" Cursor="Hand" BorderThickness="1" BorderBrush="#555555" Click="BtnRefresh_Click"/>

                <Button x:Name="btnExport" Grid.Column="3" Content="📎 Экспорт в Excel" Background="#6C3483" Foreground="White" FontSize="13" FontWeight="SemiBold" Width="140" Height="35" Margin="10,0,0,0" Cursor="Hand" BorderThickness="0" Click="BtnExport_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#2D2D2D" Padding="15" Margin="0,0,0,20" CornerRadius="5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Фильтр по статусу:" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="White"/>
                    <ComboBox x:Name="cmbStatusFilter" Width="150" Height="30" Background="#3D3D3D" Foreground="White" BorderBrush="#555555" BorderThickness="1">
                    <ComboBoxItem Content="Все экспонаты" IsSelected="True"/>
                    <ComboBoxItem Content="В наличии"/>
                    <ComboBoxItem Content="Выданы"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Background="#2D2D2D" Padding="15" Margin="0,0,0,20" CornerRadius="5">
            <DataGrid x:Name="dgvExhibits" 
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      Background="#3D3D3D"
                      Foreground="White"
                      RowBackground="#3D3D3D"
                      AlternatingRowBackground="#4D4D4D"
                      BorderBrush="#555555"
                      BorderThickness="1"
                      CanUserSortColumns="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Инв. номер" Binding="{Binding InventoryNumber}" Width="100"/>
                    <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="180"/>
                    <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="120"/>
                    <DataGridTextColumn Header="Материал" Binding="{Binding Material}" Width="120"/>
                    <DataGridTextColumn Header="Состояние" Binding="{Binding Condition}" Width="100"/>
                    <DataGridTextColumn Header="Местоположение" Binding="{Binding Location}" Width="150"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding CurrentStatus}" Width="80"/>
                    <DataGridTextColumn Header="Стоимость" Binding="{Binding Cost, StringFormat='N0'}" Width="100"/>
                    <DataGridTextColumn Header="Год создания" Binding="{Binding YearOfOrigin}" Width="100"/>
                    <DataGridTextColumn Header="Ответственный" Binding="{Binding ResponsiblePerson}" Width="150"/>
                    <DataGridTextColumn Header="Источник" Binding="{Binding Source}" Width="120"/>
                <DataGridTemplateColumn Header="Фото">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="📷" Click="BtnPhotos_Click" Tag="{Binding}" Width="40" Height="25" Background="#6C3483" Foreground="White" BorderThickness="0" ToolTip="Просмотр фотографий"/> 
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
</DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="4" Background="#2D2D2D" Padding="15" CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="btnFirst" Content="⏮" Foreground="White" FontSize="14" FontWeight="Bold" Width="40" Height="30" Cursor="Hand" Margin="2" Click="BtnFirst_Click" ToolTip="Первая страница">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="#6C3483" CornerRadius="3">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#8B4593"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#5A2874"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="btnPrev" Content="◀" Foreground="White" FontSize="14" FontWeight="Bold" Width="40" Height="30" Cursor="Hand" Margin="2" Click="BtnPrev_Click" ToolTip="Предыдущая страница">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="#6C3483" CornerRadius="3">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#8B4593"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#5A2874"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock x:Name="txtPageInfo" VerticalAlignment="Center" Margin="15,0" Foreground="White" FontSize="12"/>
                    <Button x:Name="btnNext" Content="▶" Foreground="White" FontSize="14" FontWeight="Bold" Width="40" Height="30" Cursor="Hand" Margin="2" Click="BtnNext_Click" ToolTip="Следующая страница">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="#6C3483" CornerRadius="3">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#8B4593"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#5A2874"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="btnLast" Content="⏭" Foreground="White" FontSize="14" FontWeight="Bold" Width="40" Height="30" Cursor="Hand" Margin="2" Click="BtnLast_Click" ToolTip="Последняя страница">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="#6C3483" CornerRadius="3">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#8B4593"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#5A2874"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnAdd" Content="➕ Добавить" Background="#27AE60" Foreground="White" FontSize="13" FontWeight="SemiBold" Width="120" Height="35" Cursor="Hand" BorderThickness="0" Margin="5" Click="BtnAdd_Click" ToolTip="Добавить новый экспонат"/>
                    <Button x:Name="btnEdit" Content="✏️ Редактировать" Background="#F47B20" Foreground="White" FontSize="13" FontWeight="SemiBold" Width="140" Height="35" Cursor="Hand" BorderThickness="0" Margin="5" Click="BtnEdit_Click" ToolTip="Редактировать выбранный экспонат"/>
                    <Button x:Name="btnDelete" Content="🗑️ Удалить" Background="#E74C3C" Foreground="White" FontSize="13" FontWeight="SemiBold" Width="120" Height="35" Cursor="Hand" BorderThickness="0" Margin="5" Click="BtnDelete_Click" ToolTip="Удалить выбранный экспонат"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
