<Page x:Class="MuseumAccountingSystem.Views.Pages.ExhibitsListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Экспонаты"
      Background="#ECF0F1">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Управление экспонатами" FontSize="22" FontWeight="Bold" Foreground="#1A5276" Margin="0,0,0,20"/>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtSearch" Grid.Column="0" Height="35" FontSize="13"/>

                <Button x:Name="btnSearch" Grid.Column="1" Content="Найти" 
                        Background="#2980B9" Foreground="White" Width="80" Height="30" Margin="10,0,0,0" Click="BtnSearch_Click"/>

                <Button x:Name="btnRefresh" Grid.Column="2" Content="Обновить" 
                        Background="#2980B9" Foreground="White" Width="80" Height="30" Margin="10,0,0,0" Click="BtnRefresh_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Фильтр по статусу:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="cmbStatusFilter" Width="150" Height="30" SelectionChanged="CmbStatusFilter_SelectionChanged">
                    <ComboBoxItem Content="Все экспонаты"/>
                    <ComboBoxItem Content="В наличии"/>
                    <ComboBoxItem Content="Выданы"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,20">
            <DataGrid x:Name="dgvExhibits" 
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Инв. номер" Binding="{Binding InventoryNumber}" Width="120"/>
                    <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="250"/>
                    <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="150"/>
                    <DataGridTextColumn Header="Материал" Binding="{Binding Material}" Width="120"/>
                    <DataGridTextColumn Header="Состояние" Binding="{Binding Condition}" Width="120"/>
                    <DataGridTextColumn Header="Местоположение" Binding="{Binding Location}" Width="150"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding CurrentStatus}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="4" Background="White" CornerRadius="8" Padding="15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnAdd" Content="Добавить" Background="#27AE60" Foreground="White" FontWeight="Bold" Width="120" Height="35" Click="BtnAdd_Click"/>
                <Button x:Name="btnEdit" Content="Редактировать" Background="#2980B9" Foreground="White" FontWeight="Bold" Width="120" Height="35" Margin="10,0,0,0" Click="BtnEdit_Click"/>
                <Button x:Name="btnDelete" Content="Удалить" Background="#E74C3C" Foreground="White" FontWeight="Bold" Width="120" Height="35" Margin="10,0,0,0" Click="BtnDelete_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>