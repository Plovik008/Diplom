<Page x:Class="MuseumAccountingSystem.Views.Pages.StatisticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Статистика и отчеты"
      Background="#1E1E1E">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtPageTitle" Text="Статистика и отчеты" FontSize="24" FontWeight="Bold" Foreground="#F47B20" Margin="0,0,0,20"/>

        <Border Grid.Row="0" Background="#2D2D2D" Padding="15" Margin="0,0,0,20" CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#3D3D3D" Padding="15" Margin="5" CornerRadius="5">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="txtTotalExhibits" FontSize="28" FontWeight="Bold" Foreground="#F47B20" HorizontalAlignment="Center"/>
                        <TextBlock Text="Всего экспонатов" FontSize="12" Foreground="#9E9E9E" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#3D3D3D" Padding="15" Margin="5" CornerRadius="5">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="txtActiveIssues" FontSize="28" FontWeight="Bold" Foreground="#F47B20" HorizontalAlignment="Center"/>
                        <TextBlock Text="Экспонатов на руках" FontSize="12" Foreground="#9E9E9E" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#3D3D3D" Padding="15" Margin="5" CornerRadius="5">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="txtOverdueIssues" FontSize="28" FontWeight="Bold" Foreground="#E74C3C" HorizontalAlignment="Center"/>
                        <TextBlock Text="Просроченных возвратов" FontSize="12" Foreground="#9E9E9E" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#2D2D2D" Padding="15" Margin="0,0,0,20" CornerRadius="5">
            <StackPanel>
                <TextBlock x:Name="txtPopularExhibitsTitle" Text="Самые популярные экспонаты" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                <DataGrid x:Name="dgvPopularExhibits" 
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Background="#3D3D3D"
                          Foreground="White"
                          RowBackground="#3D3D3D"
                          AlternatingRowBackground="#4D4D4D"
                          BorderBrush="#555555"
                          BorderThickness="1"
                          Height="200">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Инв. номер" Binding="{Binding InventoryNumber}" Width="120"/>
                        <DataGridTextColumn Header="Экспонат" Binding="{Binding ExhibitName}" Width="250"/>
                        <DataGridTextColumn Header="Количество выдач" Binding="{Binding IssueCount}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="#2D2D2D" Padding="15" Margin="0,0,0,20" CornerRadius="5">
            <StackPanel>
                <TextBlock x:Name="txtTeacherStatsTitle" Text="Активность преподавателей" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                <DataGrid x:Name="dgvTeacherStats" 
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Background="#3D3D3D"
                          Foreground="White"
                          RowBackground="#3D3D3D"
                          AlternatingRowBackground="#4D4D4D"
                          BorderBrush="#555555"
                          BorderThickness="1"
                          Height="200">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Преподаватель" Binding="{Binding TeacherName}" Width="200"/>
                        <DataGridTextColumn Header="Кафедра" Binding="{Binding Department}" Width="150"/>
                        <DataGridTextColumn Header="Всего выдач" Binding="{Binding TotalIssues}" Width="100"/>
                        <DataGridTextColumn Header="Возвращено" Binding="{Binding ReturnedCount}" Width="100"/>
                        <DataGridTextColumn Header="Просрочено" Binding="{Binding OverdueCount}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Background="#2D2D2D" Padding="15" CornerRadius="5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnExportTeacherStats" Content="📎 Экспорт отчета" Background="#6C3483" Foreground="White" FontSize="13" FontWeight="SemiBold" Width="150" Height="35" Cursor="Hand" BorderThickness="0" Click="BtnExportTeacherStats_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
