<Page x:Class="MuseumAccountingSystem.Views.Pages.LogsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Журнал действий"
      Background="#1E1E1E">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Журнал действий пользователей" FontSize="24" FontWeight="Bold" Foreground="#F47B20" Margin="0,0,0,20"/>

        <Border Grid.Row="1" Background="#2D2D2D" Padding="15" Margin="0,0,0,20" CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtSearch" Height="35" Background="#3D3D3D" Foreground="White" BorderBrush="#555555" BorderThickness="1" Padding="10,0" TextChanged="TxtSearch_TextChanged"/>

                <Button x:Name="btnRefresh" Grid.Column="1" Content="Обновить" Background="#3D3D3D" Foreground="White" FontSize="13" FontWeight="SemiBold" Width="80" Height="35" Margin="10,0,0,0" Cursor="Hand" BorderThickness="1" BorderBrush="#555555" Click="BtnRefresh_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#2D2D2D" Padding="15" CornerRadius="5">
            <DataGrid x:Name="dgvLogs" 
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Background="#3D3D3D"
                      Foreground="White"
                      RowBackground="#3D3D3D"
                      AlternatingRowBackground="#4D4D4D"
                      BorderBrush="#555555"
                      BorderThickness="1"
                      CanUserSortColumns="True">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата и время" Binding="{Binding ActionTime, StringFormat='dd.MM.yyyy HH:mm:ss'}" Width="150"/>
                    <DataGridTextColumn Header="Пользователь" Binding="{Binding Username}" Width="120"/>
                    <DataGridTextColumn Header="Роль" Binding="{Binding UserRole}" Width="100"/>
                    <DataGridTextColumn Header="Действие" Binding="{Binding Action}" Width="100"/>
                    <DataGridTextColumn Header="Тип" Binding="{Binding TargetType}" Width="100"/>
                    <DataGridTextColumn Header="Название" Binding="{Binding TargetName}" Width="200"/>
                    <DataGridTextColumn Header="Детали" Binding="{Binding Details}" Width="300"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>