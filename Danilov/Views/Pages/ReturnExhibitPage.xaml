<Page x:Class="MuseumAccountingSystem.Views.Pages.ReturnExhibitPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Возврат экспоната"
      Background="#1E1E1E">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Возврат экспоната" FontSize="24" FontWeight="Bold" Foreground="#F47B20" Margin="0,0,0,20"/>

        <Border Grid.Row="1" Background="#2D2D2D" Padding="20" Margin="0,0,0,20" CornerRadius="5">
            <StackPanel>
                <TextBlock Text="Поиск" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,5"/>
                <TextBox x:Name="txtSearch" Height="35" Background="#3D3D3D" Foreground="White" BorderBrush="#555555" BorderThickness="1" Padding="10,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="#2D2D2D" Padding="20" Margin="0,0,0,20" CornerRadius="5">
            <DataGrid x:Name="dgvIssuedExhibits" 
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      Background="#3D3D3D"
                      Foreground="White"
                      RowBackground="#3D3D3D"
                      AlternatingRowBackground="#4D4D4D"
                      BorderBrush="#555555"
                      BorderThickness="1">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Инв. номер" Binding="{Binding ExhibitInventoryNumber}" Width="100"/>
                    <DataGridTextColumn Header="Экспонат" Binding="{Binding ExhibitName}" Width="200"/>
                    <DataGridTextColumn Header="Преподаватель" Binding="{Binding TeacherName}" Width="180"/>
                    <DataGridTextColumn Header="Дата выдачи" Binding="{Binding IssueDate, StringFormat='dd.MM.yyyy'}" Width="100"/>
                    <DataGridTextColumn Header="Срок возврата" Binding="{Binding PlannedReturnDate, StringFormat='dd.MM.yyyy'}" Width="100"/>
                    <DataGridTextColumn Header="Цель" Binding="{Binding Purpose}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" Background="#2D2D2D" Padding="20" CornerRadius="5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnReturn" Content="ВЕРНУТЬ" Background="#27AE60" Foreground="White" FontSize="14" FontWeight="Bold" Width="160" Height="40" Cursor="Hand" BorderThickness="0" Click="BtnReturn_Click"/>
                <Button x:Name="btnRefresh" Content="Обновить" Background="#3D3D3D" Foreground="White" FontSize="14" FontWeight="Bold" Width="160" Height="40" Margin="20,0,0,0" Cursor="Hand" BorderThickness="1" BorderBrush="#555555" Click="BtnRefresh_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>