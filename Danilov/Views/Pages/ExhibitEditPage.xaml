<Page x:Class="MuseumAccountingSystem.Views.Pages.ExhibitEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Редактирование экспоната"
      Background="#1E1E1E">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" x:Name="lblTitle" FontSize="24" FontWeight="Bold" Foreground="#F47B20" Margin="0,0,0,20"/>

            <Border Grid.Row="1" Grid.Column="0" Background="#2D2D2D" Padding="15" Margin="0,0,15,0" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Инвентарный номер" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtInventoryNumber" Height="35" Margin="0,0,0,15" Background="#3D3D3D" Foreground="White" BorderBrush="#555555" BorderThickness="1"/>

                    <TextBlock Text="Название" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtName" Height="35" Margin="0,0,0,15" Background="#3D3D3D" Foreground="White" BorderBrush="#555555" BorderThickness="1"/>

                    <TextBlock Text="Категория" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtCategory" Height="35" Margin="0,0,0,15" Background="#3D3D3D" Foreground="White" BorderBrush="#555555" BorderThickness="1"/>

                    <TextBlock Text="Материал" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtMaterial" Height="35" Margin="0,0,0,15" Background="#3D3D3D" Foreground="White" BorderBrush="#555555" BorderThickness="1"/>

                    <TextBlock Text="Состояние" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cmbCondition" Height="35" Margin="0,0,0,15" Background="#3D3D3D" Foreground="White" BorderBrush="#555555" BorderThickness="1">
                        <ComboBoxItem Content="В наличии" IsSelected="True"/>
                        <ComboBoxItem Content="Выдан"/>
                    </ComboBox>

                    <TextBlock Text="Местоположение" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cmbLocation" Height="35" Margin="0,0,0,15" Background="#3D3D3D" Foreground="White" BorderBrush="#555555" BorderThickness="1">
                        <ComboBoxItem Content="Музей" IsSelected="True"/>
                        <ComboBoxItem Content="Кабинет директора"/>
                        <ComboBoxItem Content="Аудитория 101"/>
                        <ComboBoxItem Content="Аудитория 202"/>
                        <ComboBoxItem Content="Аудитория 303"/>
                        <ComboBoxItem Content="Выставочный зал"/>
                        <ComboBoxItem Content="Фондовая комната"/>
                        <ComboBoxItem Content="Реставрационная мастерская"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" Background="#2D2D2D" Padding="15" Margin="15,0,0,0" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Стоимость (руб)" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtCost" Height="35" Margin="0,0,0,15" Background="#3D3D3D" Foreground="White" BorderBrush="#555555" BorderThickness="1" Text="0"/>

                    <TextBlock Text="Год создания" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtYearOfOrigin" Height="35" Margin="0,0,0,15" Background="#3D3D3D" Foreground="White" BorderBrush="#555555" BorderThickness="1"/>

                    <TextBlock Text="Дата последней реставрации" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,5"/>
                    <DatePicker x:Name="dpLastRestoration" Height="35" Margin="0,0,0,15" Background="#3D3D3D" Foreground="White" BorderBrush="#555555" BorderThickness="1"/>

                    <TextBlock Text="Ответственное лицо" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cmbResponsiblePerson" Height="35" Margin="0,0,0,15" Background="#3D3D3D" Foreground="White" BorderBrush="#555555" BorderThickness="1" IsEditable="True">
                        <ComboBoxItem Content="Петрова А.А."/>
                        <ComboBoxItem Content="Сидоров В.В."/>
                        <ComboBoxItem Content="Иванова Е.И."/>
                        <ComboBoxItem Content="Козлов Д.С."/>
                        <ComboBoxItem Content="Морозова О.Н."/>
                    </ComboBox>

                    <TextBlock Text="Источник поступления" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cmbSource" Height="35" Margin="0,0,0,15" Background="#3D3D3D" Foreground="White" BorderBrush="#555555" BorderThickness="1" IsEditable="True">
                        <ComboBoxItem Content="Дар"/>
                        <ComboBoxItem Content="Покупка"/>
                        <ComboBoxItem Content="Находка"/>
                        <ComboBoxItem Content="Передача из музея"/>
                        <ComboBoxItem Content="Наследие"/>
                    </ComboBox>

                    <TextBlock Text="Фотографии экспоната" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>

                    <Border BorderBrush="#555555" BorderThickness="1" Height="150" Margin="0,0,0,10" Background="#2D2D2D" CornerRadius="5">
                        <Grid>
                            <Image x:Name="imgPhoto" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="txtNoPhoto" Text="Нет фотографий" Foreground="#777777" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ListBox x:Name="lstPhotoThumbnails" Height="60" Background="Transparent" BorderThickness="0" Margin="0,0,0,10" SelectionChanged="LstPhotoThumbnails_SelectionChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#3D3D3D" CornerRadius="3" Margin="2" Padding="2">
                                    <Image Source="{Binding}" Width="50" Height="50" Stretch="Uniform"/>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="btnLoadPhoto" Content="➕ Добавить фото" Background="#6C3483" Foreground="White" FontSize="13" FontWeight="SemiBold" Width="140" Height="35" Cursor="Hand" BorderThickness="0" Click="BtnLoadPhoto_Click"/>
                        <Button x:Name="btnRemovePhoto" Content="Удалить" Background="#E74C3C" Foreground="White" FontSize="13" FontWeight="SemiBold" Width="100" Height="35" Margin="10,0,0,0" Cursor="Hand" BorderThickness="0" Click="BtnRemovePhoto_Click"/>
                        <Button x:Name="btnClearPhoto" Content="Очистить все" Background="#3D3D3D" Foreground="White" FontSize="13" FontWeight="SemiBold" Width="100" Height="35" Margin="10,0,0,0" Cursor="Hand" BorderThickness="1" BorderBrush="#555555" Click="BtnClearPhoto_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#2D2D2D" Padding="15" Margin="0,20,0,0" CornerRadius="5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="btnSave" Content="💾 Сохранить" Background="#27AE60" Foreground="White" FontSize="14" FontWeight="Bold" Width="170" Height="40" Cursor="Hand" BorderThickness="0" Click="BtnSave_Click" ToolTip="Сохранить изменения"/>
                    <Button x:Name="btnCancel" Content="✖ Отмена" Background="#E74C3C" Foreground="White" FontSize="14" FontWeight="Bold" Width="150" Height="40" Margin="20,0,0,0" Cursor="Hand" BorderThickness="0" Click="BtnCancel_Click" ToolTip="Отменить изменения"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
