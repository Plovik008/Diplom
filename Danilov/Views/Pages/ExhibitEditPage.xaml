<Page x:Class="MuseumAccountingSystem.Views.Pages.ExhibitEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Редактирование экспоната"
      Background="#ECF0F1">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" x:Name="lblTitle" FontSize="22" FontWeight="Bold" Foreground="#1A5276" Margin="0,0,0,20"/>

            <Border Grid.Row="1" Grid.Column="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,15,0">
                <StackPanel>
                    <TextBlock Text="Инвентарный номер" FontSize="14" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtInventoryNumber" Height="35" Margin="0,0,0,15"/>

                    <TextBlock Text="Название" FontSize="14" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtName" Height="35" Margin="0,0,0,15"/>

                    <TextBlock Text="Категория" FontSize="14" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtCategory" Height="35" Margin="0,0,0,15"/>

                    <TextBlock Text="Материал" FontSize="14" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtMaterial" Height="35" Margin="0,0,0,15"/>

                    <TextBlock Text="Состояние" FontSize="14" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cmbCondition" Height="35" Margin="0,0,0,15">
                        <ComboBoxItem Content="В наличии" IsSelected="True"/>
                        <ComboBoxItem Content="Выдан"/>
                    </ComboBox>

                    <TextBlock Text="Местоположение" FontSize="14" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cmbLocation" Height="35" Margin="0,0,0,15">
                        <ComboBoxItem Content="Музей" IsSelected="True"/>
                        <ComboBoxItem Content="Кабинет директора"/>
                        <ComboBoxItem Content="Аудитория 101"/>
                        <ComboBoxItem Content="Аудитория 202"/>
                        <ComboBoxItem Content="Аудитория 303"/>
                        <ComboBoxItem Content="Выставочный зал"/>
                        <ComboBoxItem Content="Фондовая комната"/>
                        <ComboBoxItem Content="Реставрационная мастерская"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" Background="White" CornerRadius="8" Padding="15" Margin="15,0,0,0">
                <StackPanel>
                    <TextBlock Text="Фотография экспоната" FontSize="14" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,10"/>

                    <Border BorderBrush="#7F8C8D" BorderThickness="1" CornerRadius="8" Height="250" Margin="0,0,0,15">
                        <Image x:Name="imgPhoto" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="btnLoadPhoto" Content="Загрузить фото" Background="#2980B9" Foreground="White" Width="130" Height="35" Click="BtnLoadPhoto_Click"/>
                        <Button x:Name="btnClearPhoto" Content="Очистить" Background="#E74C3C" Foreground="White" Width="100" Height="35" Margin="10,0,0,0" Click="BtnClearPhoto_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Grid.ColumnSpan="2" Background="White" CornerRadius="8" Padding="15" Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="btnSave" Content="Сохранить" Background="#27AE60" Foreground="White" FontWeight="Bold" Width="150" Height="40" Click="BtnSave_Click"/>
                    <Button x:Name="btnCancel" Content="Отмена" Background="#E74C3C" Foreground="White" FontWeight="Bold" Width="150" Height="40" Margin="20,0,0,0" Click="BtnCancel_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>