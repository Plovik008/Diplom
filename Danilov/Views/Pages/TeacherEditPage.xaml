<Page x:Class="MuseumAccountingSystem.Views.Pages.TeacherEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Редактирование преподавателя"
      Background="#ECF0F1">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="lblTitle" FontSize="22" FontWeight="Bold" Foreground="#1A5276" Margin="0,0,0,20"/>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20" Width="500" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="ФИО" FontSize="14" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,5"/>
                <TextBox x:Name="txtFullName" Height="35" Margin="0,0,0,15"/>

                <TextBlock Text="Кафедра" FontSize="14" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,5"/>
                <TextBox x:Name="txtDepartment" Height="35" Margin="0,0,0,15"/>

                <TextBlock Text="Email" FontSize="14" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,5"/>
                <TextBox x:Name="txtEmail" Height="35" Margin="0,0,0,15"/>

                <TextBlock Text="Телефон" FontSize="14" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,5"/>
                <TextBox x:Name="txtPhone" Height="35" Margin="0,0,0,15"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="15" Width="500" HorizontalAlignment="Center" Margin="0,20,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnSave" Content="Сохранить" Background="#27AE60" Foreground="White" FontWeight="Bold" Width="150" Height="40" Click="BtnSave_Click"/>
                <Button x:Name="btnCancel" Content="Отмена" Background="#E74C3C" Foreground="White" FontWeight="Bold" Width="150" Height="40" Margin="20,0,0,0" Click="BtnCancel_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>