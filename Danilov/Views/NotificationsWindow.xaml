<Window x:Class="MuseumAccountingSystem.Views.NotificationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Просроченные экспонаты" 
        Height="450" Width="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E1E">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#6C3483" Padding="15" Margin="0,0,0,10" CornerRadius="5">
            <StackPanel>
                <TextBlock Text="⚠️ Внимание! Просроченные экспонаты" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock x:Name="txtSummary" FontSize="13" Foreground="#E8D5F5" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="#3D3D3D" Padding="10" CornerRadius="5">
            <DataGrid x:Name="dgvOverdueIssues" 
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Background="#4D4D4D"
                      Foreground="White"
                      RowBackground="#4D4D4D"
                      AlternatingRowBackground="#3D3D3D"
                      HeadersVisibility="Column">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Инв. номер" Binding="{Binding InventoryNumber}" Width="100"/>
                    <DataGridTextColumn Header="Экспонат" Binding="{Binding ExhibitName}" Width="180"/>
                    <DataGridTextColumn Header="Преподаватель" Binding="{Binding TeacherName}" Width="150"/>
                    <DataGridTextColumn Header="Просрочка (дней)" Binding="{Binding OverdueDays}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button x:Name="btnGoToReturn" Content="Перейти к возврату" Background="#F47B20" Foreground="White" FontSize="13" FontWeight="SemiBold" Width="150" Height="35" Cursor="Hand" BorderThickness="0" Margin="5" Click="BtnGoToReturn_Click"/>
            <Button x:Name="btnClose" Content="Закрыть" Background="#555555" Foreground="White" FontSize="13" FontWeight="SemiBold" Width="100" Height="35" Cursor="Hand" BorderThickness="0" Margin="5" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>