<Window x:Class="MuseumAccountingSystem.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Университет - Система учета экспонатов" 
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#1E1E1E">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#6C3483" Height="60">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="25,0,0,0">
                    <TextBlock Text="🏛️" FontSize="28" Margin="0,0,10,0"/>
                    <TextBlock Text="Университет" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Foreground="White"
                               VerticalAlignment="Center"/>
                    <TextBlock Text=" | Система учета экспонатов" 
                               FontSize="13" 
                               Foreground="#E8D5F5"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                </StackPanel>

                <Border Background="#5A2D81" CornerRadius="5" Padding="8,0" Margin="0,8">
                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Center">

                        <Button Content="Экспонаты" 
                                Background="Transparent" 
                                Foreground="White"
                                BorderThickness="0"
                                Height="44"
                                Padding="15,0"
                                Cursor="Hand"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Click="MenuExhibits_Click"/>

                        <Border Background="#4A2066" Width="1" Margin="5,8"/>

                        <Button x:Name="btnIssue" Content="Выдача" 
                                Background="Transparent" 
                                Foreground="White"
                                BorderThickness="0"
                                Height="44"
                                Padding="15,0"
                                Cursor="Hand"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Click="MenuIssue_Click"/>

                        <Border Background="#4A2066" Width="1" Margin="5,8"/>

                        <Button Content="Возврат" 
                                Background="Transparent" 
                                Foreground="White"
                                BorderThickness="0"
                                Height="44"
                                Padding="15,0"
                                Cursor="Hand"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Click="MenuReturn_Click"/>

                        <Border Background="#4A2066" Width="1" Margin="5,8"/>

                        <Button Content="Журнал" 
                                Background="Transparent" 
                                Foreground="White"
                                BorderThickness="0"
                                Height="44"
                                Padding="15,0"
                                Cursor="Hand"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Click="MenuJournal_Click"/>

                        <Border Background="#4A2066" Width="1" Margin="5,8"/>

                        <Button x:Name="btnUsers" Content="Пользователи" 
                                Background="Transparent" 
                                Foreground="White"
                                BorderThickness="0"
                                Height="44"
                                Padding="15,0"
                                Cursor="Hand"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Visibility="Collapsed"
                                Click="MenuUsers_Click"/>

                        <Border x:Name="usersSeparator" Background="#4A2066" Width="1" Margin="5,8" Visibility="Collapsed"/>

                        <Button x:Name="btnTeachers" Content="Преподаватели" 
                                Background="Transparent" 
                                Foreground="White"
                                BorderThickness="0"
                                Height="44"
                                Padding="15,0"
                                Cursor="Hand"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Click="MenuTeachers_Click"/>

                        <Border Background="#4A2066" Width="1" Margin="5,8"/>

                        <Button x:Name="btnStatistics" Content="Отчеты" 
                                Background="Transparent" 
                                Foreground="White"
                                BorderThickness="0"
                                Height="44"
                                Padding="15,0"
                                Cursor="Hand"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Click="MenuStatistics_Click"/>

                        <Border Background="#4A2066" Width="1" Margin="5,8"/>

                        <Button Content="Календарь" 
                                Background="Transparent" 
                                Foreground="White"
                                BorderThickness="0"
                                Height="44"
                                Padding="15,0"
                                Cursor="Hand"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Click="MenuCalendar_Click"/>

                        <Border x:Name="logsSeparator" Background="#4A2066" Width="1" Margin="5,8" Visibility="Collapsed"/>

                        <Button x:Name="btnLogs" Content="Журнал действий" 
                                Background="Transparent" 
                                Foreground="White"
                                BorderThickness="0"
                                Height="44"
                                Padding="15,0"
                                MinWidth="160"
                                Cursor="Hand"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Visibility="Collapsed"
                                Click="MenuLogs_Click"/>

                        <Border x:Name="backupSeparator" Background="#4A2066" Width="1" Margin="5,8" Visibility="Collapsed"/>

                        <Button x:Name="btnBackup" Content="Резервная копия" 
                                Background="Transparent" 
                                Foreground="White"
                                BorderThickness="0"
                                Height="44"
                                Padding="10,0"
                                Width="145"
                                Cursor="Hand"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Visibility="Collapsed"
                                Click="MenuBackup_Click"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Center"
                            Margin="0,0,25,0">

                    <Border Background="#8E44AD" 
                            Padding="12,5"
                            Margin="0,0,15,0">
                        <TextBlock x:Name="txtUserInfo" 
                                   Foreground="White"
                                   FontSize="12"/>
                    </Border>

                    <Button Content="Выход" 
                            Background="#F47B20" 
                            Foreground="White"
                            BorderThickness="0"
                            Height="35"
                            Width="80"
                            Cursor="Hand"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Click="MenuExit_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#1E1E1E" Padding="20">
            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
        </Border>

        <StatusBar Grid.Row="2" Background="#2D2D2D" Height="28">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" 
                           Foreground="#9E9E9E" 
                           FontSize="11"
                           Margin="15,0,0,0"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="Готов к работе" 
                           Foreground="#9E9E9E" 
                           FontSize="11"
                           Margin="0,0,15,0"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
