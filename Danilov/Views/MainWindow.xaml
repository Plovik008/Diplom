<Window x:Class="MuseumAccountingSystem.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Университет - Система учета экспонатов" 
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#1E1E1E">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#6C3483" Height="60">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="25,0,0,0">
                    <TextBlock Text="🏛️" FontSize="28" Margin="0,0,10,0"/>
                    <TextBlock Text="Университет" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Foreground="White"
                               VerticalAlignment="Center"/>
                    <TextBlock Text=" | Система учета экспонатов" 
                               FontSize="13" 
                               Foreground="#E8D5F5"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center">

                    <Button Content="Экспонаты" 
                            Background="Transparent" 
                            Foreground="White"
                            BorderThickness="0"
                            Height="60"
                            Width="110"
                            Cursor="Hand"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Click="MenuExhibits_Click"/>

                    <Button Content="Выдача" 
                            Background="Transparent" 
                            Foreground="White"
                            BorderThickness="0"
                            Height="60"
                            Width="110"
                            Cursor="Hand"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Click="MenuIssue_Click"/>

                    <Button Content="Возврат" 
                            Background="Transparent" 
                            Foreground="White"
                            BorderThickness="0"
                            Height="60"
                            Width="110"
                            Cursor="Hand"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Click="MenuReturn_Click"/>

                    <Button Content="Журнал" 
                            Background="Transparent" 
                            Foreground="White"
                            BorderThickness="0"
                            Height="60"
                            Width="110"
                            Cursor="Hand"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Click="MenuJournal_Click"/>

                    <Button Content="Преподаватели" 
                            Background="Transparent" 
                            Foreground="White"
                            BorderThickness="0"
                            Height="60"
                            Width="120"
                            Cursor="Hand"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Click="MenuTeachers_Click"/>

                    <Button Content="Отчеты" 
                            Background="Transparent" 
                            Foreground="White"
                            BorderThickness="0"
                            Height="60"
                            Width="110"
                            Cursor="Hand"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Click="MenuStatistics_Click"/>

                    <Button Content="Календарь" 
                            Background="Transparent" 
                            Foreground="White"
                            BorderThickness="0"
                            Height="60"
                            Width="110"
                            Cursor="Hand"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Click="MenuCalendar_Click"/>

                    <Button x:Name="btnLogs" Content="Журнал действий" 
                            Background="Transparent" 
                            Foreground="White"
                            BorderThickness="0"
                            Height="60"
                            Width="130"
                            Cursor="Hand"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Visibility="Collapsed"
                            Click="MenuLogs_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Center"
                            Margin="0,0,25,0">

                    <Border Background="#8E44AD" 
                            Padding="12,5"
                            Margin="0,0,15,0">
                        <TextBlock x:Name="txtUserInfo" 
                                   Foreground="White"
                                   FontSize="12"/>
                    </Border>

                    <Button Content="Выход" 
                            Background="#F47B20" 
                            Foreground="White"
                            BorderThickness="0"
                            Height="35"
                            Width="80"
                            Cursor="Hand"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Click="MenuExit_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#1E1E1E" Padding="20">
            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
        </Border>

        <StatusBar Grid.Row="2" Background="#2D2D2D" Height="28">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" 
                           Foreground="#9E9E9E" 
                           FontSize="11"
                           Margin="15,0,0,0"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="Готов к работе" 
                           Foreground="#9E9E9E" 
                           FontSize="11"
                           Margin="0,0,15,0"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>